<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DragonSword.CameraNoDelay.Setup</AssemblyName>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <Description>드래곤소드 카메라 및 키보드 메뉴 조작 모드 설치 및 삭제</Description>
    <PayloadArchive Condition="'$(PayloadArchive)' == ''">$(MSBuildProjectDirectory)\..\..\staging\manager-payload-v0.4.0.zip</PayloadArchive>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="CameraNoDelay.Payload.zip" />
  </ItemGroup>
</Project>
